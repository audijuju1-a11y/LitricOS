# Build output. Regenerated by `cargo` and by the gate; never reviewed as source.
src/target/

# Generated tool and gate output: logs, dumped frames, page dumps, screenshots.
build/
tools/logs/
__pycache__/
*.pyc

# Agent-tool host state. `project-id` names this checkout on this machine only.
.freebuff/

# VM and image artifacts. Large, regenerable, and never the thing under review.
*.raw
*.qcow2
*.img
*.iso

# Development signing keys are excluded by keys/.gitignore, which is the file that
# states why: a committed signing key — even a development one — is a key that
# will eventually be used by mistake.

# Workspace archives: a snapshot of this checkout, never evidence and never
# reviewed. The gate and the tracker cite the files, not a tarball of them.
artifacts/*.tar.gz
artifacts/*.zip

# QEMU proof runs keep their small screenshots, serial logs and result JSON in
# git. The extracted guest rootfs, kernel images, initramfs, raw PPM captures,
# QMP sockets and QEMU BIOS data are reproducible run products and are too large
# for a source repository.
artifacts/qemu-guest-proof/**/rootfs/
artifacts/qemu-guest-proof/**/qemu-data/
artifacts/qemu-guest-proof/**/network/
artifacts/qemu-guest-proof/**/litricos-qemu-initramfs.cpio.gz
artifacts/qemu-guest-proof/**/*.ppm
artifacts/qemu-guest-proof/**/*.sock

# Release packaging output: generated by tools/build.sh and not source.
dist/
