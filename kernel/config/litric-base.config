#
# LITRIC OS — Kernel Configuration Fragment
# Based on: x86_64 defconfig + Litric-specific overlay
# Target: QEMU virt + modern PC (x86-64 first-class)
# 
# Usage: apply this fragment on top of defconfig
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config kernel/config/litric-base.config
#   make olddefconfig
#
# STATUS: DESIGN-ONLY — not yet verified against a real kernel build
#

# =============================================================================
# SECTION 1: LITRIC CORE FEATURES (mandatory per MASTER §3)
# =============================================================================

# MGLRU — Multi-Gen LRU page reclaim (Google fleet-proven)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# sched_ext — BPF-based scheduler framework (scx_lavd in Phase 12)
CONFIG_SCHED_CLASS_EXT=y

# ntsync — Wine/Proton NT synchronization primitives (mainlined 6.14)
CONFIG_NTSYNC=y

# fanotify — Defender on-access scanning (Phase 07)
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# Landlock — unprivileged LSM for app sandboxing
CONFIG_SECURITY_LANDLOCK=y

# BPF-LSM — behavioral hooks for defender (Phase 07)
CONFIG_BPF_LSM=y

# dm-verity — read-only rootfs integrity (Phase 03)
CONFIG_DM_VERITY=y

# erofs — compressed read-only filesystem (Phase 03)
CONFIG_EROFS_FS=y

# Btrfs — snapshot-capable user filesystem (Phase 03)
CONFIG_BTRFS_FS=y

# zram — compressed swap (Phase 02)
CONFIG_ZRAM=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y

# Preemption — low-latency desktop (Phase 05/06/12)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y

# EFI boot
CONFIG_EFI_STUB=y

# GDB kernel debugging support
CONFIG_GDB_SCRIPTS=y

# =============================================================================
# SECTION 2: BOOT / EFI
# =============================================================================

CONFIG_EFI=y
# CONFIG_EFI_STUB declared once in SECTION 1 (duplicate removed)
CONFIG_EFI_PARTITION=y
CONFIG_DMI=y
CONFIG_DMIID=y

# =============================================================================
# SECTION 3: VIRTIO (QEMU virtualization)
# =============================================================================

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_FS=m
CONFIG_9P_FS=m
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m

# =============================================================================
# SECTION 4: STORAGE
# =============================================================================

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536

# NVMe (for real hardware, Phase 11)
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# SCSI (for virtio-scsi if needed)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y

# ATA/AHCI (for real hardware SATA)
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# UFS (not needed for QEMU, kept for Phase 11)
# CONFIG_SCSI_UFSHCD is not set

# MD/RAID (not needed for initial boot)
# CONFIG_MD_RAID0 is not set
# CONFIG_MD_RAID1 is not set

# =============================================================================
# SECTION 5: FILESYSTEMS
# =============================================================================

CONFIG_EXT4_FS=y
# CONFIG_BTRFS_FS declared once in SECTION 1 (duplicate removed)
CONFIG_BTRFS_FS_POSIX_ACL=y
# CONFIG_EROFS_FS declared once in SECTION 1 (duplicate removed)
CONFIG_FUSE_FS=m
CONFIG_CUSE=m

# Proc/Sys (required)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# =============================================================================
# SECTION 6: NETWORKING
# =============================================================================

CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m

CONFIG_DNS_RESOLVER=y
CONFIG_NET_KEY=m
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=m

# =============================================================================
# SECTION 7: SECURITY
# =============================================================================

CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y

# --- the LSM stack ---------------------------------------------------------
# Every name in CONFIG_LSM below must have its symbol enabled here. The kernel
# silently IGNORES an unknown name in the LSM list, so a list naming an LSM that
# was never compiled in reads as a hardened system and is not one. This file
# previously listed seven LSMs while enabling two; ci/lint-kconfig.py now fails
# the build on that mismatch.
#
# CONFIG_SECURITY_LANDLOCK and CONFIG_BPF_LSM are declared once, in SECTION 1.

# yama: restricts ptrace to descendants. Pairs with kernel.yama.ptrace_scope=1.
CONFIG_SECURITY_YAMA=y

# lockdown: closes the paths by which root can modify the running kernel
# (kexec of an unsigned image, /dev/mem, raw MSR writes, unsigned modules).
# Load-bearing for the Secure Boot chain: without it, root defeats verified boot.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y

# loadpin: kernel modules and firmware may only be loaded from the filesystem
# the first one came from. On LitricOS that filesystem is the dm-verity-protected
# read-only system partition, which makes this unusually strong here: a module
# can only load if it was in the signed image.
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_ENFORCE=y

# safesetid: constrains which UID/GID transitions a process may make. Cheap, and
# it closes a common privilege-escalation step after a service compromise.
CONFIG_SECURITY_SAFESETID=y

# integrity: the substrate IMA/EVM build on. Enabled so `integrity` in the LSM
# list refers to something real; IMA policy itself is a Phase 07 decision with a
# measured overhead requirement attached.
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y

# AppArmor: enabled. The desktop image installs the distribution's `apparmor`
# package and enables `apparmor.service`; the Settings service page reads the
# kernel's own enable flag and securityfs profile list, and offers a reload only
# when the parser and status client are both present. AppArmor is additive to
# the Landlock + seccomp + bubblewrap stack: it confines programs by profile
# while Landlock confines them by the file descriptors they were handed.
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# SELinux remains unused: LitricOS has no SELinux policy tree.
# CONFIG_SECURITY_SELINUX is not set

CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# This list MUST match lsm= on the kernel command line in image/mkosi.conf.
# The command line overrides the compiled-in default, so a disagreement means
# the config is not what runs -- and the config is what people read.
# loadpin is deliberately ABSENT from this list.
#
# BUG-0003 added it with the reasoning that LitricOS modules live on a
# dm-verity-protected read-only partition, so pinning module loading to that
# filesystem would be unusually strong here. That reasoning was wrong about how
# LoadPin works.
#
# LoadPin pins to the FIRST filesystem a module is loaded from -- which is the
# initrd's tmpfs, not the verity root:
#
#   LoadPin: mnt_sb lacks block device, treating as: writable
#   LoadPin: ... pinned  obj=".../vsock.ko.zst" pid=1 cmdline="/init"
#   LoadPin: ... denied  obj=".../vfat.ko.zst"
#   LoadPin: ... denied  obj=".../tcp_bbr.ko.zst"
#   LoadPin: ... denied  obj=".../tun.ko.zst"
#
# After switch-root every module comes from a different filesystem and is
# denied. That silently removed vfat (so the ESP could not mount, which took out
# the system bus), BBR congestion control, tun, and every other module the
# running system needs. The symptom -- "unknown filesystem type 'vfat'" -- points
# nowhere near an LSM.
#
# It is not needed here either: dm-verity already guarantees that every module on
# the system partition hashes back to a signed root hash. That is the property
# loadpin was meant to add, and we already have it. Module signature enforcement
# (CONFIG_MODULE_SIG_FORCE) is the orthogonal, correct mechanism and is a Phase
# 07 item requiring our own kernel build.
#
# CONFIG_SECURITY_LOADPIN stays enabled so the option remains available; only
# its activation is removed.
CONFIG_LSM="landlock,lockdown,yama,safesetid,integrity,apparmor,bpf"

# Audit
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ASLR
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Stack protection
CONFIG_CC_STACKPROTECTOR=y
CONFIG_CC_STACKPROTECTOR_STRONG=y

# =============================================================================
# SECTION 8: DRM / GRAPHICS (for compositor, Phase 05)
# =============================================================================

CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_BOCHS=m
# CONFIG_DRM_CIRRUS_QEMU was removed in Linux 5.9. QEMU's modern display
# devices are virtio-gpu (preferred) and bochs-display, both already enabled.
CONFIG_DRM_VIRTIO_GPU=y

# =============================================================================
# SECTION 9: INPUT
# =============================================================================

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# =============================================================================
# SECTION 10: AUDIO (PipeWire kernel side, Phase 05)
# =============================================================================

CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_HWDEP=m
CONFIG_SND_RAWMIDI=m
CONFIG_SND_JACK=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_VIRMIDI=m
CONFIG_SND_DUMMY=m
CONFIG_SND_VIRTUOSO=m
CONFIG_SND_USB_AUDIO=m

# =============================================================================
# SECTION 11: USB (for real hardware, Phase 11)
# =============================================================================

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# =============================================================================
# SECTION 12: POWER MANAGEMENT
# =============================================================================

CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE=y

# =============================================================================
# SECTION 13: CRYPTO (for LUKS2, dm-verity)
# =============================================================================

CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_ARC4=m
CONFIG_CRYPTO_DES=m
CONFIG_CRYPTO_MD5=y

# Hardware crypto acceleration
CONFIG_CRYPTO_AES_NI_INTEL=y

# =============================================================================
# SECTION 14: TRACING / DEBUGGING
# =============================================================================

CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# =============================================================================
# SECTION 15: CLEARED OPTIONS (disabled for image size reduction)
# =============================================================================

# Disable unnecessary filesystems
# CONFIG_CODA_FS is not set
# CONFIG_AFS_FS is not set
# CONFIG_NCPFS is not set
# CONFIG_SMB_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set

# Disable unnecessary networking protocols
# CONFIG_IPX is not set
# CONFIG_ATALK is not set
# CONFIG_DECnet is not set
# CONFI
