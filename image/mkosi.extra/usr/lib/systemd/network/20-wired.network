# LitricOS — wired networking on real hardware.
#
# This is the file a physical machine uses: it asks the DHCP client for an
# address, a prefix, a gateway and DNS, which is what a LAN, a home router and a
# corporate network all expect. The previous revision hard-coded QEMU's slirp
# lease (10.0.2.15/24, gateway 10.0.2.2, DNS 10.0.2.3) for every `en*`/`eth*`
# interface, which was true only inside the virtual machine the proofs run in and
# wrong on every real network. On real hardware that address is either outside
# the subnet or already in use, so the link came up and nothing routed.
#
# The virtual machine keeps its deterministic static address in
# `10-qemu-slirp.network`, which matches QEMU's default NIC MAC instead of the
# interface name. `systemd-networkd` applies the first matching file in lexical
# order, so 10- wins inside QEMU and 20- is the only match on real hardware.
#
# Both naming schemes are matched because a minimal image may not run udev's
# predictable renaming: "eth0" before udev, "enp0s*t*" after it.

[Match]
Name=en* eth*

[Network]
DHCP=yes
IPv6AcceptRA=yes
