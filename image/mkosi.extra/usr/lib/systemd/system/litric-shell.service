[Unit]
Description=LitricOS desktop shell
Documentation=file:///usr/share/doc/litric/adr/0017-framebuffer-shell.md
Slice=litric-shell.slice

# HONEST SCOPE, 2026-08-29.
#
# This unit previously described the compositor in ADR-0009: Type=notify, a
# `litric` user, a PAM session, seatd, DRM and input device access, a watchdog.
# None of that existed, and the unit could not start; it was a description of an
# intention wearing the clothes of a service.
#
# What exists now is the display half, a real input stack and client windows:
# litric-shell discovers the framebuffer and the input devices, renders the
# desktop in software, routes keyboard and pointer events through a window
# manager, writes only the rows that changed, and serves Wayland from inside
# its own process so that an ordinary Linux application can open a window on
# this desktop (ADR-0024). It still needs no seat and no PAM session: the
# framebuffer and evdev are opened directly, and the Wayland socket lives in
# this unit's own runtime directory. The unit grows toward the compositor of
# ADR-0009 one capability at a time, each because something needs it.

After=basic.target litric-sysd.service litric-first-run.service
Requires=litric-first-run.service
Wants=litric-sysd.service

# The kernel's framebuffer console and a login prompt both draw on the same
# pixels. The shell unbinds fbcon itself; the getty has to be displaced here,
# because two programs owning tty1 is a fight neither wins.
Conflicts=getty@tty1.service

# Without a display there is nothing to draw on, and starting anyway would
# produce a failed unit on every headless CI boot. That is noise, not a finding.
#
# The leading pipe makes these OR rather than AND. A machine whose card has a
# KMS driver and no fbdev node is exactly the machine the DRM/KMS path exists
# for (ADR-0026); requiring /dev/fb0 would refuse to start the desktop on it.
# Match the four nodes `drm::discover_card` actually scans. Stopping at card1
# would leave a desktop that never starts on a machine whose panel is card2/3,
# even though the provider could drive it.
ConditionPathExists=|/dev/fb0
ConditionPathExists=|/dev/dri/card0
ConditionPathExists=|/dev/dri/card1
ConditionPathExists=|/dev/dri/card2
ConditionPathExists=|/dev/dri/card3

[Service]
Type=simple
# No interval: the shell runs an event loop that blocks on input and repaints
# only what changed. An idle desktop presents nothing at all, which is where
# Adaptive Idle's saving actually comes from.
ExecStart=/usr/bin/litric-shell
# The session's runtime directory. Without it the shell falls back to a private
# directory under $HOME, which this unit's ProtectHome=yes makes unreachable --
# so the variable is set explicitly rather than left to the environment.
Environment=XDG_RUNTIME_DIR=/run/litric

# Persistent state, one directory per owner, all under /var so a reboot does
# not take them with it. Systemd creates each with mode 0700 and opens exactly
# these through the ProtectSystem=strict boundary below:
#
#   litric-shell    settings.conf (language, theme, reduced motion)
#   litric-browser  browser-data.conf (history and bookmarks)
#
# `litric-files` used to be on this list. It is GONE as of 2026-10-26: the user's
# documents are served by `litric-filesd` over `/run/litric/files.sock` (ADR-0019)
# and the daemon's own unit owns `/var/lib/litric-files`. A shell that keeps a
# writable handle on the document root while claiming to have delegated file I/O
# to a daemon is a delegation on paper only.
#
# `litric-browser` was missing here while main.rs wrote
# /var/lib/litric-browser/browser-data.conf. With ProtectSystem=strict that
# directory is on a read-only mount inside this unit, so every save was EROFS
# and the file never existed after a restart. Neither directory is opened at a
# wider path: / remains read-only for this service, and so does the document
# root the daemon serves.
StateDirectory=litric-shell litric-browser
StateDirectoryMode=0700

RuntimeDirectory=litric
# 0700, not 0755. The Wayland socket for client applications lives here, and a
# Wayland socket is an unauthenticated door to the compositor: whoever can open
# it can read another application's window and send it input. The directory is
# the lock, so it is closed to every other user on the machine.
RuntimeDirectoryMode=0700
# Both litric-sysd and litric-shell declare /run/litric. Without this, systemd
# deletes the directory when EITHER unit stops -- taking the other one's socket
# or status file with it, and producing a shell that cannot reach a daemon that
# is still running. Preserving it is not laziness about cleanup: /run is tmpfs
# and the whole directory is gone at reboot regardless.
RuntimeDirectoryPreserve=yes
StandardOutput=journal+console
StandardError=journal+console

Restart=on-failure
RestartSec=1s

# --- sandbox ---------------------------------------------------------------
# It needs exactly three things: the framebuffer, sysfs to find it and to
# release the console, and the sysd socket under /run. Everything else is off.
#
# THREAT ACCEPTED: write access to /dev/fb0 is write access to the screen, so a
# compromised shell can draw anything, including a convincing password prompt.
# That is inherent to any display server. The mitigations are that it holds no
# capabilities, cannot open a network socket, cannot execute anything, and has
# no access to the user's files at all -- so what it can do is limited to
# lying on the screen, and it cannot act on what it learns.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=no
DeviceAllow=/dev/fb0 rw
DeviceAllow=char-drm rw
# Read-only on input. The shell must see what the user does; it must never be
# able to synthesise an event, which write access to an evdev node would allow.
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# ProtectKernelTunables would make /sys read-only, and releasing the framebuffer
# console is a write to /sys/class/vtconsole/vtconN/bind. It is off for that one
# write and nothing else; the sandbox above still denies every other route.
ProtectKernelTunables=no

# The 140 MB slice limit is measured against the actual 1920x1080 framebuffer:
# wallpaper, scene, lock cache, and shaped glyph runs all live in this process.
# The slice applies MemoryHigh=110M before the hard 140 MB ceiling.
# One thread per input device plus the main loop. A machine with a dozen input
# devices is unusual; a shell with a hundred threads is a bug.
TasksMax=32

[Install]
WantedBy=multi-user.target
