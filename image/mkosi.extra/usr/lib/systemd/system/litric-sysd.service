[Unit]
Description=LitricOS system daemon
Documentation=file:///usr/share/doc/litric/adr/0016-system-daemon.md

# After basic.target, not multi-user.target. Ordering a unit after the target
# that pulls it in is a dependency cycle; systemd resolves it by dropping the
# ordering and the unit never runs -- enabled, no error, no output. That exact
# mistake already cost this project a debugging session on litric-selftest.
After=basic.target

# Nothing above this exists yet. When litric-shell does, it will order itself
# after this unit, because a shell that draws a trash icon before there is a
# trash behind it is drawing a picture.

[Service]
Type=simple
# The boot entrypoint runs before the socket exists. It reads the generation
# record, counts one attempt for a staged candidate and, when the third attempt
# was already used, rejects that candidate while leaving the active generation
# untouched. It never blocks boot on a missing or damaged record: it reports the
# result on the console and the service still starts, so the damaged state is
# diagnosable instead of producing a machine that will not come up.
ExecStartPre=/usr/bin/litric-sysd --boot --update-root /var/lib/litric/update
ExecStart=/usr/bin/litric-sysd --serve --socket /run/litric/sysd.sock --update-root /var/lib/litric/update

# The socket is a runtime object and must not survive a reboot. It could not
# live anywhere else anyway: / is a read-only dm-verity root.
RuntimeDirectory=litric
# 0700, matching litric-shell and litric-notifyd. This directory also holds the
# shell's Wayland socket, which is an unauthenticated door to the compositor;
# a unit that asked for 0755 would widen the directory whenever it creates it
# first, so all three units state the same restrictive mode.
RuntimeDirectoryMode=0700
# Both litric-sysd and litric-shell declare /run/litric. Without this, systemd
# deletes the directory when EITHER unit stops -- taking the other one's socket
# or status file with it, and producing a shell that cannot reach a daemon that
# is still running. Preserving it is not laziness about cleanup: /run is tmpfs
# and the whole directory is gone at reboot regardless.
RuntimeDirectoryPreserve=yes

# Measurements reach the serial console as well as the journal. On a headless
# VM the console is the only channel out, and a daemon that started and said
# nothing cannot be told apart from one that never started.
StandardOutput=journal+console
StandardError=journal+console

Restart=on-failure
RestartSec=1s

# --- sandbox ---------------------------------------------------------------
# The daemon reads /proc and /sys, binds one Unix socket, and holds decision
# state in memory. It opens no files of its own, and reaches no network.
#
# It is NOT true, however, that it needs no capability at all, and that sentence
# used to be here. The read half needs none; the write half owns the plans the
# shell asks for, and `NET LINK` execs `/usr/bin/ip link set <iface> up`, which
# goes through an AF_NETLINK socket and needs CAP_NET_ADMIN. Booting the image is
# what proved it: with an empty bounding set and AF_UNIX-only, the in-guest probe
# answered `litric.sysd.net_link_lo=NO -- ERR action-failed /usr/bin/ip exited 1`
# while every host-side test passed, because none of them runs `ip` inside this
# sandbox. The capability is therefore granted, one, with the reason recorded
# here as PHASE-02's `CapabilityBoundingSet=  # empty unless justified` requires.
#
# Each line below is a claim that will be tested by booting, not by reading.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
# AmbientCapabilities as well as the bounding set: an exec'd tool inherits the
# ambient set regardless of how it is reached, so the grant does not silently
# depend on the call path.
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
# `NET WIFI JOIN` writes the passphrase iwd reads into iwd's own directory, and
# ProtectSystem=strict would fail that write with EROFS. Exactly one directory is
# opened for writing, the same pattern litric-mm-tune uses for /sys/kernel/mm;
# image/mkosi.extra/usr/lib/tmpfiles.d/litric-iwd.conf guarantees it exists
# before this unit's mount namespace is set up, so ReadWritePaths never names a
# path that is absent -- systemd fails the unit outright when it does.
#
# `/etc` is the second, and it is opened for the first-run wizard's
# `AUTH SET PASSWORD`, which runs chpasswd(8). Shadow's update protocol needs a
# writable /etc *directory*, not a writable /etc/shadow: PAM creates
# /etc/.pwd.lock and the update writes /etc/shadow+ then rename(2)s it over
# /etc/shadow, and a file-level bind on /etc/shadow is not merely insufficient
# -- the rename onto a bind mountpoint fails with EBUSY. Both variants were
# booted and probed inside this unit's own namespace: with file binds the
# wizard's action answered `Authentication token manipulation error`, with the
# directory writable chpasswd changed the password and left no /etc/shadow+
# behind (the rename completed). The earlier symptom was the wizard printing
# `ERR action-failed /usr/sbin/chpasswd exited 1` with `Authentication token
# lock busy` -- the PAM lock file could not be created on the read-only view.
#
# /etc is an overlay (upperdir /var/lib/litric/etc-overlay/upper on the
# read-only /var), but an overlay writes through its own upper mount, which
# this namespace does not touch, so opening /etc here is enough and /var
# remains read-only: a direct write to the upperdir inside the namespace still
# fails with EROFS (measured).
ReadWritePaths=/var/lib/iwd /etc /var/lib/litric/update
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No JIT and no generated code: the binary is ahead-of-time compiled Rust with
# no interpreter in it, so this costs nothing and closes the usual route from a
# memory-write primitive to code execution.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX for the shell's socket, AF_NETLINK for `ip`. Still no INET: the daemon
# has no reason to reach the network and, having no reason, is not permitted to
# discover one (IPAddressDeny=any below is the belt to this pair of braces).
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

# A resource ceiling on the thing that measures resources. If the daemon ever
# grows past this it should fail loudly here rather than quietly become the
# reason the machine is short of memory.
MemoryMax=64M
TasksMax=64

[Install]
WantedBy=multi-user.target
