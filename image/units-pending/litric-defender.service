[Unit]
Description=LitricOS Defender (on-access scanning)
Documentation=file:///usr/share/doc/litric/SEC-00-threatmodel.md
After=local-fs.target litric-capd.service
# A boot entry that sets litric.defender=off is the documented escape hatch for
# "the defender is blocking a system binary" (Phase 07 failure mode).
ConditionKernelCommandLine=!litric.defender=off

[Service]
Type=notify
ExecStart=/usr/bin/litric-defender --rules /usr/lib/litric/yara --cache /var/cache/litric/defender
Restart=always
RestartSec=1s
WatchdogSec=60s

Slice=litric-defender.slice

# --- sandbox ---------------------------------------------------------------
# fanotify permission events require CAP_SYS_ADMIN. There is no way around that:
# it is the capability that lets a process gate other processes' file opens.
#
# THREAT ACCEPTED: a compromise of litric-defender is effectively root.
# Mitigated by (a) nothing else in the bounding set, (b) no network at all,
# (c) the YARA rule parser is fuzzed in CI and rule files are verity-checked
# before load, (d) the worker that actually touches file *content* is a separate
# unprivileged process, litric-defender-scan, which receives file descriptors
# and returns verdicts. The privileged process never parses attacker-controlled
# bytes.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @privileged
SystemCallErrorNumber=EPERM
CacheDirectory=litric/defender
StateDirectory=litric/defender

[Install]
WantedBy=multi-user.target
